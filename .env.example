# Telegram 機器人 Token (由 @BotFather 取得)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# MiniMax API 金鑰
MINIOC_API_KEY=your_minimax_api_key_here

# API 端點。預設為 https://api.minimax.io
# 可指向自訂代理；路徑前綴、連接埠與 http/https 協定都會被保留。
# 若填入完整端點（結尾為 /v1/text/chatcompletion_v2），則原樣使用、不重複附加路徑。
MINIOC_BASE_URL=https://api.minimax.io

# 推論模型，預設 MiniMax-M3
MINIOC_MODEL=MiniMax-M3

# --- 以下皆為選用，未設定時使用預設值 ---

# 設為 true 時，啟動會清空所有既有對話。預設不設定（保留歷史）
# CLEAR_HISTORY_ON_START=false

# 單則訊息的長度上限（字元），預設 4000
# MAX_MESSAGE_LENGTH=4000

# 速率限制的視窗長度（毫秒），預設 60000
# RATE_LIMIT_WINDOW_MS=60000

# 單一使用者在一個視窗內可發送的訊息數上限，預設 10
# RATE_LIMIT_MAX_REQUESTS=10
